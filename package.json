{
  "name": "@hexiaowu/dsh-web-search-zai",
  "version": "0.1.1",
  "description": "Z.ai / Zhipu GLM web-search provider for the DeepSeek Harness ctx.web seam",
  "license": "MIT",
  "author": "hexiaowu",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "zai",
    "zhipu",
    "glm",
    "coding-plan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "README.en.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "probe": "node test/probe.mjs",
    "check": "node --check lib/index.js && node --check client.js && node --test test/*.test.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexiaowu/dsh-web-search-zai.git"
  },
  "homepage": "https://github.com/hexiaowu/dsh-web-search-zai#readme",
  "bugs": {
    "url": "https://github.com/hexiaowu/dsh-web-search-zai/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
